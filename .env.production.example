# Copy to .env on the server and fill in. Never commit the real .env.
APP_NAME="NB Yaseen Advocates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nbyadvocates.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_DATABASE=nbyadvocates
DB_USERNAME=nby
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@nbyadvocates.com"
MAIL_FROM_NAME="${APP_NAME}"
